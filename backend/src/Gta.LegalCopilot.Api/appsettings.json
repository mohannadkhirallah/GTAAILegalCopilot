{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "RootPath": "./data",
    "MaxUploadBytes": 20971520
  },
  "AzureOpenAI": {
    "Endpoint": "",
    "ApiKey": "",
    "Deployment": "gpt-4o",
    "Enabled": true
  },
  "Statutory": {
    "ObjectionWindowDays": 30,
    "AuthorityDecisionWindowDays": 60,
    "GrievanceWindowDays": 30,
    "MonthlyDelayPenaltyRate": 0.015,
    "DelayPenaltyCapRatio": 1.0,
    "CorporateTaxRate": 0.10
  },
  "SubstantivePolicy": {
    "EvidencedManagementFeeAdmissibleShare": 0.50,
    "EvidencedTransferPricingAdmissibleShare": 0.50
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
